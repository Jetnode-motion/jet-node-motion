 "lines": [
  {
   "at": 0.25,
   "dur": 2.76,
   "scene": "lift",
   "cap": "В час ночи я зашёл в лифт и нажал *девятый.*"
  },
  {
   "at": 3.26,
   "dur": 3.315,
   "scene": "lift",
   "cap": "И тут завибрировал *телефон.*"
  },
  {
   "at": 6.876,
   "dur": 6.08,
   "scene": "chat",
   "cap": "«Кто сейчас в лифте? *На камере двое*»"
  },
  {
   "at": 13.206,
   "dur": 0.929,
   "scene": "chat",
   "cap": "Я был *один.*"
  },
  {
   "at": 14.435,
   "dur": 4.453,
   "scene": "mirror",
   "cap": "Только я. И *пустая кабина* за спиной."
  },
  {
   "at": 19.188,
   "dur": 4.946,
   "scene": "chat2",
   "cap": "«Пусть *не оборачивается*»"
  },
  {
   "at": 24.434,
   "dur": 6.148,
   "scene": "panel",
   "cap": "Лифт ехал *выше.*"
  },
  {
   "at": 30.782,
   "dur": 3.149,
   "scene": "panel",
   "cap": "Кнопки *не нажимались.*"
  },
  {
   "at": 34.281,
   "dur": 3.365,
   "scene": "panel",
   "cap": "В нашем доме *двенадцать этажей.*"
  },
  {
   "at": 37.996,
   "dur": 3.197,
   "scene": "doors",
   "cap": "За ними был *тёмный коридор.*"
  },
  {
   "at": 41.443,
   "dur": 4.644,
   "scene": "doors",
   "cap": "С номером *моей квартиры.*"
  },
  {
   "at": 46.387,
   "dur": 5.266,
   "scene": "chat3",
   "cap": "«Он хочет, чтобы ты *вышел первым*»"
  },
  {
   "at": 52.003,
   "dur": 4.611,
   "scene": "shadow",
   "cap": "Рядом с моей тенью — *вторая.*"
  },
  {
   "at": 57.015,
   "dur": 3.811,
   "scene": "last",
   "cap": "Хотя я свою *не поднимал.*"
  },
  {
   "at": 61.726,
   "dur": 1.987,
   "scene": "end",
   "cap": "Продолжение — во *второй* части"
  }
 ],
