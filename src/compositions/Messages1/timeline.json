{
 "duration": 78.67,
 "lines": [
  {
   "at": 0.25,
   "dur": 2.316,
   "scene": "phone",
   "cap": "В час ночи мне написал мой же *номер.*"
  },
  {
   "at": 2.766,
   "dur": 2.16,
   "scene": "phone",
   "cap": "«Не открывай дверь. *Это не я*»"
  },
  {
   "at": 5.226,
   "dur": 3.958,
   "scene": "block",
   "cap": "Я живу *один.* Девятый этаж, однушка на окраине."
  },
  {
   "at": 9.385,
   "dur": 3.92,
   "scene": "block",
   "cap": "Сначала решил — *спам.* Или друзья прикалываются."
  },
  {
   "at": 13.555,
   "dur": 1.84,
   "scene": "bed",
   "cap": "Написал: «Кто *это?*»"
  },
  {
   "at": 15.595,
   "dur": 3.627,
   "scene": "bed",
   "cap": "Ответ пришёл сразу. «Ты. Только на *10 минут позже*»"
  },
  {
   "at": 19.572,
   "dur": 1.621,
   "scene": "door",
   "cap": "И тут в дверь *позвонили.*"
  },
  {
   "at": 21.443,
   "dur": 7.073,
   "scene": "peep",
   "cap": "На площадке стоял сосед, *дядя Коля.* В тапках, с пустой кружкой."
  },
  {
   "at": 28.716,
   "dur": 2.56,
   "scene": "peep",
   "cap": "«Соль не одолжишь?» В *час ночи.*"
  },
  {
   "at": 31.576,
   "dur": 5.97,
   "scene": "bed2",
   "cap": "«Дядя Коля умер в прошлом году. Ты был *на похоронах*»"
  },
  {
   "at": 38.146,
   "dur": 4.262,
   "scene": "memory",
   "cap": "Я правда был на похоронах. Помню венок. Помню *дождь.*"
  },
  {
   "at": 42.658,
   "dur": 3.978,
   "scene": "door2",
   "cap": "А звонок всё звенел. Ровно. *Без пауз.*"
  },
  {
   "at": 46.836,
   "dur": 2.08,
   "scene": "door2",
   "cap": "Я написал: «Что мне *делать?*»"
  },
  {
   "at": 49.166,
   "dur": 5.537,
   "scene": "window",
   "cap": "«Выключи свет. Встань у окна. И *не отвечай* ему»"
  },
  {
   "at": 55.003,
   "dur": 5.299,
   "scene": "voice",
   "cap": "И из-за двери заговорил голос. *Мой собственный.*"
  },
  {
   "at": 60.602,
   "dur": 2.859,
   "scene": "voice",
   "cap": "«Открой. Это я. *Я тебе писал*»"
  },
  {
   "at": 63.811,
   "dur": 2.723,
   "scene": "last",
   "cap": "Телефон загорелся *последним* сообщением"
  },
  {
   "at": 66.735,
   "dur": 2.869,
   "scene": "last",
   "cap": "«Я не успел. Теперь *твоя очередь* писать»"
  },
  {
   "at": 70.504,
   "dur": 2.163,
   "scene": "end",
   "cap": "Продолжение — во *второй* части"
  }
 ],
