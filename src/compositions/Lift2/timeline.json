  {
   "at": 32.102,
   "dur": 5.715,
   "scene": "close",
   "cap": "На аватарке — *наш лифт.*"
  },
  {
   "at": 38.017,
   "dur": 2.747,
   "scene": "cctv2",
   "cap": "На фото я. *И он.*"
  },
  {
   "at": 41.014,
