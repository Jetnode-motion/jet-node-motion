  {
   "at": 0.0,
   "dur": 5.12,
   "scene": "cctv",
   "cap": "В сорок седьмой *никто не живёт.*"
  },
  {
   "at": 5.32,
   "dur": 5.038,
   "scene": "mirror",
   "cap": "В нашем доме *их двенадцать.*"
  },
  {
   "at": 10.558,
   "dur": 4.206,
   "scene": "mirror2",
   "cap": "За моей спиной *стоял он.*"
  },
  {
   "at": 14.965,
   "dur": 3.49,
   "scene": "chat",
   "cap": "«На камере *ты один*»"
  },
  {
   "at": 18.655,
   "dur": 3.715,
   "scene": "floor",
   "cap": "Две тени. А человек *один.*"
