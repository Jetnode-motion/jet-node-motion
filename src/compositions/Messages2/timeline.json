  {
   "at": 0.25,
   "dur": 5.18,
   "scene": "reread",
   "cap": "Я перечитал это *раз десять.*"
  },
  {
   "at": 5.73,
   "dur": 2.72,
   "scene": "quiet",
   "cap": "За дверью стало тихо. *Слишком тихо.*"
