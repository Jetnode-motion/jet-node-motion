  {
   "at": 23.273,
   "dur": 4.628,
   "scene": "prints",
   "cap": "Мокрые следы. От двери — *в мою комнату.*"
  },
  {
   "at": 28.151,
   "dur": 3.44,
   "scene": "prints",
   "cap": "Босые. А тапки дяди Коли *стояли у порога.*"
  },
  {
   "at": 31.891,
   "dur": 4.896,
   "scene": "roomdoor",
   "cap": "Мой телефон. Но он был *у меня в руке.*"
  },
  {
   "at": 37.087,
   "dur": 5.036,
   "scene": "bedroom",
   "cap": "На кровати *спал я.* А рядом светился телефон."
  },
  {
   "at": 42.373,
   "dur": 2.88,
   "scene": "bedroom",
   "cap": "Строчка в чате мигала: *одна минута.*"
  },
  {
   "at": 45.553,
   "dur": 5.735,
   "scene": "send",
   "cap": "«Не открывай дверь. *Это не я*»"
